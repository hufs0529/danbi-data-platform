# infra/bootstrap 의 `terraform output -raw backend_hcl` 결과로 바꾼다. (infra/backend.hcl 은 git에 넣지 않는다)
bucket       = "danbi-dev-tfstate-123456789012"
region       = "ap-northeast-2"
encrypt      = true
kms_key_id   = "arn:aws:kms:ap-northeast-2:123456789012:key/00000000-0000-0000-0000-000000000000"
use_lockfile = true
# key 는 Makefile 이 스택마다 넘긴다:  -backend-config="key=dev/<stack>.tfstate"
